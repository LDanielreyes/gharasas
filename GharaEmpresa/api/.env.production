# ==========================================
# GHARA SAS - API BACKEND - PRODUCCIÓN (cPanel)
# ==========================================
# INSTRUCCIONES: Copiar como .env en el servidor cPanel.
# Reemplazar los valores marcados con <...> por los reales.

# --- Base de Datos (MySQL cPanel) ---
DATABASE_URL="mysql://<USUARIO_CPANEL>:<PASSWORD_DB>@localhost:3306/gharasas_db"

# --- JWT (Generar con: openssl rand -base64 64) ---
JWT_SECRET="<GENERAR_SECRET_ALEATORIO_64_CHARS>"
JWT_REFRESH_SECRET="<GENERAR_REFRESH_SECRET_ALEATORIO_64_CHARS>"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# --- SMTP (cPanel Mail o servicio externo) ---
SMTP_HOST="mail.gharasas.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="info@gharasas.com"
SMTP_PASS="<PASSWORD_CORREO_CPANEL>"
SMTP_FROM="info@gharasas.com"

# --- Cloudflare Turnstile (Obtener en https://dash.cloudflare.com/turnstile) ---
TURNSTILE_SITE_KEY="<CLAVE_SITIO_REAL>"
TURNSTILE_SECRET_KEY="<CLAVE_SECRETA_REAL>"

# --- CORS (dominios permitidos) ---
CORS_ORIGINS="https://gharasas.com,https://www.gharasas.com,https://admin.gharasas.com"

# --- Server ---
PORT=3001
NODE_ENV="production"
