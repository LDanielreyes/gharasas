# ==========================================
# GHARA SAS - API BACKEND - VARIABLES DE ENTORNO
# ==========================================

# --- Base de Datos ---
DATABASE_URL="mysql://usuario:password@localhost:3306/ghara"

# --- JWT ---
JWT_SECRET="your_secret_key_here_min_32_chars"
JWT_REFRESH_SECRET="your_refresh_secret_here_min_32_chars"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# --- SMTP (Mailtrap para desarrollo - emails no llegan reales) ---
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="tu-usuario-mailtrap"
SMTP_PASS="tu-password-mailtrap"
SMTP_FROM="info@gharasas.com"

# --- Cloudflare Turnstile (Claves de Testing - siempre pasan) ---
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# --- CORS ---
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:5174,https://www.gharasas.com,https://admin.gharasas.com"

# --- Server ---
PORT=3001
NODE_ENV="development"
